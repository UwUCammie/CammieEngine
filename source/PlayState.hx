	var psychStageGroupCameras:Map<String, Array<FlxCamera>> = new Map();
	@:keep public function setPsychStageGroupCameras(role:String, cameras:Array<Dynamic>):Void {
		psychStageGroupCameras.set(role, cast cameras);
