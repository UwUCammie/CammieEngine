				var dur = e.v1 != '' ? parseF(e.v1) : 0.5;
				var col:FlxColor = switch (StringTools.trim(e.v2)) {
					case '2': 0xFF4D6FFF;
					case '3': 0xFFBA1E24;
					default: 0xFFFFFFFF;
				};
				FlxG.camera.flash(col, dur);
